    "DangerSoft": "#FBD3D8",
    "Panel": "#EBFFF7EF",
    "Edge": "#C9A48E",
    "Ink": "#4A3A33",
    "Muted": "#8A6E62",
    "ScheduleNow": "#E8798A",
    "Mint": "#D9843A",
    "Danger": "#E05A6E",
    "CalendarSunday": "#E05A6E",
    "CalendarSaturday": "#4E86C2",
