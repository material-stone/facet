<UserControl x:Class="Facet.QuickLaunchView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:design="clr-namespace:Facet.Design">
 <UserControl.Resources>
  <Style x:Key="HelpMode" TargetType="Border"><Setter Property="Background" Value="{StaticResource Input}"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="HelpPrefix" TargetType="Border"><Setter Property="Background" Value="{StaticResource Hover}"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="7,2"/><Setter Property="Margin" Value="10,0,0,0"/></Style>
  <Style x:Key="CandidateName" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="Normal"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="LaunchRow" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="14,10"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Frame" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource Selected}"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource Hover}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid Margin="24,0" HorizontalAlignment="Center" MaxWidth="680" x:Name="Layout">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="InputFrame" Grid.Row="1" CornerRadius="16" Background="{StaticResource Panel}" BorderBrush="{StaticResource Muted}" BorderThickness="1" Padding="20,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Image x:Name="LeadingIcon" Width="28" Height="28" Margin="0,0,14,0" Visibility="Collapsed"/>
    <design:Icon x:Name="LeadingCommandIcon" Kind="Help" Width="28" Height="28" Margin="0,0,14,0" Foreground="{StaticResource Mint}" Visibility="Collapsed" VerticalAlignment="Center"/>
    <Grid Grid.Column="1" ClipToBounds="True">
     <TextBlock x:Name="Ghost" FontSize="28" FontWeight="Bold" FontFamily="{StaticResource AppFontFamily}" Foreground="{StaticResource Muted}" Opacity="0.5" TextWrapping="NoWrap" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <TextBox x:Name="Input" Style="{x:Null}" FontSize="28" FontWeight="Bold" FontFamily="{StaticResource AppFontFamily}" Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Mint}" SelectionBrush="{StaticResource Selected}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" VerticalContentAlignment="Center" MaxLength="32760" AutomationProperties.Name="빠른 실행 입력">
      <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Style="{StaticResource RoundedScrollViewer}" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" Background="Transparent" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></ControlTemplate></TextBox.Template>
     </TextBox>
    </Grid>
   </Grid>
  </Border>
  <Border x:Name="HelpPanel" Grid.Row="0" VerticalAlignment="Bottom" Margin="0,8,0,12" CornerRadius="16" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="18" Visibility="Collapsed" AutomationProperties.Name="빠른 실행 사용법">
   <ScrollViewer x:Name="HelpScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel>
     <WrapPanel Margin="0,0,0,12"><design:Icon Kind="Help" Width="22" Height="22" Foreground="{StaticResource Mint}" Margin="0,0,10,0"/><TextBlock Text="빠른 실행 사용법" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Style="{StaticResource HelpPrefix}" VerticalAlignment="Center"><TextBlock Text="&gt; help" FontSize="12" FontFamily="{StaticResource AppFontFamily}"/></Border><TextBlock Text="열기 / 닫기" FontSize="11" Foreground="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/></WrapPanel>
     <Border Style="{StaticResource HelpMode}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <design:Icon Kind="Dashboard" Width="24" Height="24" Foreground="{StaticResource Mint}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1"><StackPanel Orientation="Horizontal"><TextBlock Text="앱 실행" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Style="{StaticResource HelpPrefix}"><TextBlock Text="기본 입력" FontSize="11"/></Border></StackPanel>
       <TextBlock FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"><Run Text="PATH 앱 이름으로 실행 · "/><Run Text="notepad" Foreground="{StaticResource Mint}"/></TextBlock>
      </StackPanel>
     </Grid></Border>
     <Border Style="{StaticResource HelpMode}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <design:Icon Kind="Folder" Width="24" Height="24" Foreground="{StaticResource Mint}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1"><StackPanel Orientation="Horizontal"><TextBlock Text="파일·폴더 열기" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Style="{StaticResource HelpPrefix}"><TextBlock Text="@" FontSize="11" FontFamily="{StaticResource AppFontFamily}"/></Border></StackPanel>
       <TextBlock FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"><Run Text="절대 경로를 탐색기로 열기 · "/><Run Text="@D:\project" Foreground="{StaticResource Mint}"/></TextBlock>
      </StackPanel>
     </Grid></Border>
     <Border Style="{StaticResource HelpMode}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <design:Icon Kind="Link" Width="24" Height="24" Foreground="{StaticResource Mint}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1"><StackPanel Orientation="Horizontal"><TextBlock Text="alias 열기" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Style="{StaticResource HelpPrefix}"><TextBlock Text="@@" FontSize="11" FontFamily="{StaticResource AppFontFamily}"/></Border></StackPanel>
       <TextBlock FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"><Run Text="등록한 이름을 탐색기로 열기 · "/><Run Text="@@작업" Foreground="{StaticResource Mint}"/></TextBlock>
      </StackPanel>
     </Grid></Border>
     <Border Style="{StaticResource HelpMode}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <design:Icon Kind="Play" Width="24" Height="24" Foreground="{StaticResource Mint}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1"><StackPanel Orientation="Horizontal"><TextBlock Text="예약 명령어" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Style="{StaticResource HelpPrefix}"><TextBlock Text="&gt;" FontSize="11" FontFamily="{StaticResource AppFontFamily}"/></Border></StackPanel>
       <TextBlock Text="&gt; 입력으로 검색 · Enter 또는 후보 클릭으로 실행" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
       <TextBlock FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"><Run Text="&gt; help" Foreground="{StaticResource Mint}"/><Run Text=" · 도움말 열기 / 닫기"/></TextBlock>
      </StackPanel>
     </Grid></Border>
     <Border Style="{StaticResource HelpMode}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <design:Icon Kind="Link" Width="24" Height="24" Foreground="{StaticResource Mint}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1"><StackPanel Orientation="Horizontal"><TextBlock Text="웹 검색" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Style="{StaticResource HelpPrefix}"><TextBlock Text="?" FontSize="11"/></Border></StackPanel>
       <TextBlock FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"><Run Text="? 검색어 / 웹 주소" Foreground="{StaticResource Mint}"/><Run Text=" · Enter로 검색 또는 페이지 열기"/></TextBlock>
       <TextBlock Text="설정 → 단축키·빠른 실행 → 검색 엔진" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
      </StackPanel>
     </Grid></Border>
     <WrapPanel Margin="0,4,0,0">
      <StackPanel Orientation="Horizontal" Margin="0,0,16,6"><design:Icon Kind="Play" Width="14" Height="14" Foreground="{StaticResource Muted}" Margin="0,0,5,0"/><TextBlock Text="Enter 실행" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,16,6"><design:Icon Kind="Check" Width="14" Height="14" Foreground="{StaticResource Muted}" Margin="0,0,5,0"/><TextBlock Text="Tab 완성" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><design:Icon Kind="Close" Width="14" Height="14" Foreground="{StaticResource Muted}" Margin="0,0,5,0"/><TextBlock Text="Esc 닫기" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
     </WrapPanel>
     <StackPanel Orientation="Horizontal"><design:Icon Kind="Settings" Width="14" Height="14" Foreground="{StaticResource Muted}" Margin="0,0,5,0"/><TextBlock Text="alias 등록: 설정 → 탐색기 alias" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Border>
  <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,10,0,16">
   <Border x:Name="CandidatesFrame" CornerRadius="12" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="5" Visibility="Collapsed">
    <ListBox x:Name="Candidates" Style="{x:Null}" Background="Transparent" Foreground="{StaticResource Ink}" BorderThickness="0" ItemContainerStyle="{StaticResource LaunchRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="380" KeyboardNavigation.TabNavigation="None" AutomationProperties.Name="실행 후보">
     <ListBox.Template><ControlTemplate TargetType="ListBox">
      <ScrollViewer Style="{StaticResource RoundedScrollViewer}" Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"><ItemsPresenter/></ScrollViewer>
     </ControlTemplate></ListBox.Template>
     <ListBox.ItemTemplate><DataTemplate>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,12,0"><Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
       <design:Icon Kind="Help" Width="24" Height="24" Margin="0,0,12,0" Foreground="{StaticResource Mint}"><design:Icon.Style><Style TargetType="design:Icon"><Style.Triggers><DataTrigger Binding="{Binding Candidate.Command}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></design:Icon.Style></design:Icon>
       <StackPanel Grid.Column="1"><TextBlock Text="{Binding Candidate.Text}" Style="{StaticResource CandidateName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Candidate.Target}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel>
      </Grid>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Border>
   <TextBlock x:Name="Status" Foreground="{StaticResource Muted}" Margin="12,8,0,0" Visibility="Collapsed"/>
  </StackPanel>
 </Grid>
</UserControl>
