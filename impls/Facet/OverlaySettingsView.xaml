<UserControl x:Class="Facet.OverlaySettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 MaxWidth="800" HorizontalAlignment="Stretch" FontSize="{StaticResource TypeBody}">
 <UserControl.Resources>
  <Style x:Key="SideTab" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{StaticResource Muted}"/>
   <Setter Property="Padding" Value="12,9"/>
   <Setter Property="Margin" Value="0,0,0,4"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="B" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ContentPresenter VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Edge}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Mint}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource Selected}"/><Setter Property="Foreground" Value="{StaticResource Mint}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="16" Padding="24">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="120" MaxWidth="168"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border x:Name="SectionFrame" Grid.RowSpan="3" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,1,0" Padding="0,0,16,0" Margin="0,0,20,0">
    <DockPanel>
     <TextBox x:Name="SearchInput" DockPanel.Dock="Top" Tag="설정 검색" MaxLength="200" AutomationProperties.Name="설정 검색"
              Margin="0,0,0,16" TextChanged="Search_Changed"/>
     <ScrollViewer x:Name="SectionScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="SectionNav" AutomationProperties.Name="설정 분류" KeyboardNavigation.DirectionalNavigation="Cycle"/>
     </ScrollViewer>
    </DockPanel>
   </Border>
   <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <StackPanel x:Name="Groups"/>
     <TextBlock x:Name="EmptyMessage" Text="검색 결과가 없습니다. 다른 키워드로 검색해 보세요."
                Foreground="{StaticResource Muted}" Margin="0,24" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
   </ScrollViewer>
   <Grid x:Name="StatusBar" Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="Status" Text="설정은 변경하면 자동으로 저장됩니다." Foreground="{StaticResource Muted}"
               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite"/>
    <Button x:Name="RetryButton" Grid.Column="1" Content="다시 시도" Visibility="Collapsed"
            Margin="0" Click="Save_Click" AutomationProperties.Name="설정 자동 저장 다시 시도"/>
   </Grid>
  </Grid>
 </Border>
</UserControl>
