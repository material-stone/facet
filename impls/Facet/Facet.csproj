<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings><ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Facet</AssemblyName><Version>1.35.0</Version>
    <AssemblyTitle>Facet</AssemblyTitle><Product>Facet</Product><Description>Facet desktop overlay</Description>
    <ApplicationIcon>Design/AppIcon/Facet.ico</ApplicationIcon>
    <!-- This is a WPF app. WinForms is used only for the tray; DPI is owned by the WPF manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Facet.Core/Facet.Core.csproj" /><ProjectReference Include="../Facet.Plugins/Facet.Plugins.csproj" /></ItemGroup>
  <ItemGroup><PackageReference Include="Markdig" Version="1.4.2" /><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" /></ItemGroup>
  <ItemGroup><Resource Include="DashboardWeather/Icons/*.png" /></ItemGroup>
  <ItemGroup><Resource Include="Design/AppIcon/Facet.ico" /></ItemGroup>
  <ItemGroup><Resource Include="Design/Skins/*/theme.json;Design/Skins/*/*.png" /></ItemGroup>
  <ItemGroup><Resource Include="Design/World/world.html" /></ItemGroup>
  <ItemGroup><Resource Include="DashboardWeather/WeatherRegions.json" /></ItemGroup>
  <ItemGroup><Resource Include="DashboardWeather/WeatherAdministrativeRegions.json" /></ItemGroup>
  <ItemGroup>
    <Resource Include="Design/Fonts/Pretendard-*.ttf;Design/Fonts/Jua-Regular.ttf;Design/Fonts/GowunDodum-Regular.ttf" />
    <Content Include="Design/Fonts/Pretendard-LICENSE.txt;Design/Fonts/Jua-LICENSE.txt;Design/Fonts/GowunDodum-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    
    <Compile Include="../Facet.Launcher/LaunchProtocol.cs" Link="LaunchProtocol.cs" />
    <Compile Include="../Facet.Launcher/ReleaseManifest.cs" Link="ReleaseManifest.cs" />
    <InternalsVisibleTo Include="Facet.JournalChecks" />
  </ItemGroup>
</Project>
