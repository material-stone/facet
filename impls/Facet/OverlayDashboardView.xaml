<UserControl x:Class="Facet.OverlayDashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:design="clr-namespace:Facet.Design"
 xmlns:local="clr-namespace:Facet"
 AutomationProperties.Name="현재 날짜와 날씨" Focusable="False">
 <StackPanel>
 <Grid x:Name="DashboardHeader" VerticalAlignment="Top">
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="300"/>
   <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="Auto"/>
   <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="84"/>
  </Grid.ColumnDefinitions>
  <StackPanel x:Name="ClockGroup" HorizontalAlignment="Left" Width="300">
   <Viewbox x:Name="DateHost" Width="300" Height="38" Stretch="Fill" HorizontalAlignment="Left">
    <TextBlock x:Name="DateText" FontSize="24" FontWeight="Medium" TextWrapping="NoWrap"/>
   </Viewbox>
   <Viewbox x:Name="TimeHost" Width="300" Height="60" Stretch="Fill" HorizontalAlignment="Left" Margin="0,10,0,0">
    <TextBlock x:Name="TimeText" FontSize="48" FontWeight="SemiBold" TextWrapping="NoWrap"
               Typography.NumeralAlignment="Tabular"/>
   </Viewbox>
  </StackPanel>
  <Grid x:Name="WeatherHoverArea" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left"
        Background="Transparent" Focusable="False" KeyboardNavigation.TabNavigation="None">
   <Grid.Triggers>
    <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard>
     <DoubleAnimation Storyboard.TargetName="HoverChrome" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
    </Storyboard></BeginStoryboard></EventTrigger>
    <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard>
     <DoubleAnimation Storyboard.TargetName="HoverChrome" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
    </Storyboard></BeginStoryboard></EventTrigger>
   </Grid.Triggers>
   <Grid x:Name="HoverChrome" Margin="-10" Opacity="0" IsHitTestVisible="False">
    <Border Background="{StaticResource Hover}" CornerRadius="12" Opacity="0.4"/>
   </Grid>
  <Button x:Name="WeatherRefresh" VerticalAlignment="Center" HorizontalAlignment="Left"
          Focusable="False" IsTabStop="False" KeyboardNavigation.TabNavigation="None"
          Style="{x:Null}" FocusVisualStyle="{x:Null}" Background="Transparent" Foreground="{StaticResource Ink}" BorderThickness="0" Padding="0" Cursor="Hand"
          Click="RefreshWeatherClicked" AutomationProperties.Name="날씨 새로고침"
          AutomationProperties.HelpText="현재 날씨를 다시 불러옵니다. 조회 중에는 사용할 수 없습니다.">
   <Button.Template>
    <ControlTemplate TargetType="Button">
     <Grid Background="{TemplateBinding Background}">
      <ContentPresenter/>
     </Grid>
    </ControlTemplate>
   </Button.Template>
  <StackPanel x:Name="WeatherGroup" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
   <Image x:Name="WeatherIcon" Width="84" Height="84" Margin="0,0,16,0" Stretch="Uniform"
          Visibility="Hidden" RenderOptions.BitmapScalingMode="HighQuality"/>
   <StackPanel MaxWidth="236" VerticalAlignment="Center" HorizontalAlignment="Left">
    <StackPanel Orientation="Horizontal">
     <TextBlock x:Name="LocationText" Text="현재 위치 확인 중" FontSize="12" Foreground="{StaticResource Muted}"
                MaxWidth="126" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
     <TextBlock x:Name="ConditionText" Text="날씨 확인 중" FontSize="13" FontWeight="SemiBold" Margin="12,0,0,0"
                MaxWidth="98" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
     <TextBlock x:Name="TemperatureText" Text="--°C" FontSize="32" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <StackPanel x:Name="HumidityGroup" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="습도">
      <design:Icon x:Name="HumidityIcon" Kind="Droplet" Width="16" Height="18" Foreground="{StaticResource CalendarSaturday}" Margin="0,0,6,0"/>
      <TextBlock x:Name="HumidityText" Text="--%" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
     </StackPanel>
    </StackPanel>
    <Grid Margin="0,6,0,0">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="64"/>
     </Grid.ColumnDefinitions>
     <TextBlock x:Name="WeatherStatusHost" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
      <Run x:Name="WeatherStatus" Text="날씨 연결 대기"/>
     </TextBlock>
     <ProgressBar x:Name="WeatherLoading" Grid.Column="1" Height="3" Margin="8,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                  IsHitTestVisible="False" Focusable="False" IsTabStop="False"
                  IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="날씨 불러오는 중"/>
    </Grid>
   </StackPanel>
  </StackPanel>
  </Button>
  </Grid>
 </Grid>
 <StackPanel x:Name="AgendaSection" Margin="0">
  <TextBlock Text="오늘 주요 일정·알림" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
  <ScrollViewer x:Name="AgendaScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">

   <StackPanel x:Name="AgendaItems" Orientation="Horizontal"/>
  </ScrollViewer>
 </StackPanel>
 </StackPanel>
</UserControl>
