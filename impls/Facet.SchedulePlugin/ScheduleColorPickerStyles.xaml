<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="HuePage" TargetType="RepeatButton">
  <Setter Property="Focusable" Value="False"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="HueSlider" TargetType="Slider">
  <Setter Property="Height" Value="22"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="Slider">
    <Grid Background="Transparent">
     <Border x:Name="HueBand" Height="12" CornerRadius="6" IsHitTestVisible="False">
      <Border.Background>
       <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="Red" Offset="0"/><GradientStop Color="Yellow" Offset="0.1666666667"/>
        <GradientStop Color="Lime" Offset="0.3333333333"/><GradientStop Color="Cyan" Offset="0.5"/>
        <GradientStop Color="Blue" Offset="0.6666666667"/><GradientStop Color="Magenta" Offset="0.8333333333"/>
        <GradientStop Color="Red" Offset="1"/>
       </LinearGradientBrush>
      </Border.Background>
     </Border>
     <Track x:Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
      <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource HuePage}" Command="{x:Static Slider.DecreaseLarge}"/></Track.DecreaseRepeatButton>
      <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource HuePage}" Command="{x:Static Slider.IncreaseLarge}"/></Track.IncreaseRepeatButton>
      <Track.Thumb>
       <Thumb Width="14" Height="22" Cursor="SizeWE">
        <Thumb.Template><ControlTemplate TargetType="Thumb">
         <Border Background="Transparent" BorderBrush="#99000000" BorderThickness="1" CornerRadius="4">
          <Border Background="Transparent" BorderBrush="White" BorderThickness="2" CornerRadius="3"/>
         </Border>
        </ControlTemplate></Thumb.Template>
       </Thumb>
      </Track.Thumb>
     </Track>
    </Grid>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
</ResourceDictionary>
