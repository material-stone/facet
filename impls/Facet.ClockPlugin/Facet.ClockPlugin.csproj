<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <!-- The host supplies the contract, so the plugin folder holds only this assembly and its manifest. -->
  <ItemGroup><ProjectReference Include="../Facet.Plugins/Facet.Plugins.csproj" Private="false" /></ItemGroup>
  <ItemGroup><None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <!-- The app owns the shared clock face; the plugin compiles the same file (ADR 0082). -->
  <ItemGroup><Compile Include="../Facet/Widgets/ClockFitButton.cs" Link="ClockFitButton.cs" /></ItemGroup>
</Project>
